#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_japanese1 {
            bindings = <&kp GRAVE>;
            key-positions = <70 41>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <70 44>;
        };

        combo_ltu {
            bindings = <&ltu_macro>;
            key-positions = <69 44>;
        };

        combo_keypad {
            bindings = <&tog 1>;
            key-positions = <42 70>;
        };

        combo_japanese2 {
            bindings = <&kp GRAVE>;
            key-positions = <41 69>;
        };

        combo_keypad2 {
            bindings = <&tog 1>;
            key-positions = <42 69>;
        };
    };

    macros {
        ltu_macro: ltu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp L &kp T &kp U>;

            label = "LTU_MACRO";
        };

        n00_macro: n00_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp N0 &kp N0>;

            label = "N00_MACRO";
        };

        esc_macro: esc_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release>, <&kp LSHIFT>, <&macro_tap>, <&kp ESC>;

            label = "ESC_MACRO";
        };

        copy_macro: copy_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LC(C)>;

            label = "COPY_MACRO";
        };

        paste_macro: paste_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LC(V)>;

            label = "PASTE_MACRO";
        };

        cut_macro: cut_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LC(X)>;

            label = "CUT_MACRO";
        };

        Lshift_macro: Lshift_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LSHIFT>;

            label = "LSHIFT_MACRO";
        };

        Rshift_macro: Rshift_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_press>,
                <&kp RSHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp RSHIFT>;

            label = "RSHIFT_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp N1  &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                                                        &mo 3                &kp N6  &kp N7  &kp N8     &kp N9                              &kp N0                             &kp MINUS
&kp TAB     &kp Q   &kp W     &kp E     &kp R      &kp T   &kp INTERNATIONAL_1                                                                                           &kp EQUAL            &kp Y   &kp U   &kp I      &kp O                               &kp P                              &kp LEFT_BRACKET
&kp GRAVE   &kp A   &kp S     &kp D     &kp F      &kp G   &kp TAB              &mt LALT LA(TAB)  &mt LCTRL LA(LC(TAB))      &mt LG(D) K_APPLICATION  &mt LCTRL LC(TAB)  &kp INTERNATIONAL_3  &kp H   &kp J   &kp K      &kp L                               &kp SEMI                           &kp SQT
&kp LSHIFT  &kp Z   &kp X     &kp C     &kp V      &kp B                                          &mt LC(HOME) HOME          &esc_macro                                                       &kp N   &kp M   &kp COMMA  &kp DOT                             &kp FSLH                           &Rshift_macro
&kp LCTRL   &mo 4   &kp LGUI  &kp LEFT  &kp RIGHT          &mt LCTRL SPACE      &lt 4 DELETE      &mt LC(END) END            &kp TAB                  &kp ENTER          &kp BSPC                     &kp UP  &kp DOWN   &mt LG(LEFT_BRACKET) RIGHT_BRACKET  &mt LG(RIGHT_BRACKET) NON_US_HASH  &mo 2
            >;
        };

        layer_keypad {
            bindings = <
&kp ESC        &kp N1     &kp N2                &kp N3             &kp N4           &kp N5    &trans                                                                              &mo 3                &kp GRAVE      &kp KP_NUMLOCK  &kp LS(MINUS)  &kp KP_DIVIDE  &kp LS(SINGLE_QUOTE)  &kp MINUS
&kp TAB        &kp F2     &kp KP_DIVIDE         &kp UP             &kp PG_UP        &kp TAB   &kp INTERNATIONAL_1                                                                 &kp EQUAL            &kp LS(MINUS)  &kp N7          &kp N8         &kp N9         &kp MINUS             &kp LEFT_BRACKET
&kp GRAVE      &kp HOME   &kp LEFT_ARROW        &kp LS(SEMICOLON)  &kp RIGHT_ARROW  &kp END   &kp TAB              &mt LEFT_ALT LA(TAB)  &trans        &copy_macro  &paste_macro  &kp INTERNATIONAL_3  &kp N0         &kp N4          &kp N5         &kp N6         &kp LS(SEMICOLON)     &kp SQT
&Lshift_macro  &kp LC(Z)  &kp LS(SINGLE_QUOTE)  &kp DOWN           &kp PG_DN        &kp BSPC                                             &kp HOME      &kp ESC                                         &kp COMMA      &kp N1          &kp N2         &kp N3         &n00_macro            &Rshift_macro
&kp LCTRL      &mo 4      &kp LGUI              &kp LEFT           &kp RIGHT                  &mt LCTRL SPACE      &trans                &kp END       &kp TAB      &kp ENTER     &kp BACKSPACE                       &kp UP          &kp DOWN       &kp PERIOD     &kp N0                &mo 2
            >;
        };

        layer_fn {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &tog 1                                      &mo 3   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10       &kp F11
&trans   &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans  &trans        &trans
&trans   &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans        &trans
&trans   &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans        &trans
&trans   &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &kp LEFT_ALT  &trans
            >;
        };

        layer_mod {
            bindings = <
&kp ESC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none         &none       &none  &none  &none
&none    &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &out OUT_USB  &none       &none  &none  &none
&kp ESC  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none         &none       &none  &none  &none
&none    &none         &none         &none         &macro_ver    &out OUT_BLE                      &none      &none                                           &none  &none         &none       &none  &none  &none
&none    &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC    &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_vim_like {
            bindings = <
&trans         &trans         &kp F2         &trans         &kp LA(F4)     &trans     &trans                                                                                       &trans    &trans     &trans     &kp LA(F8)  &trans        &trans        &trans
&trans         &trans         &kp LC(W)      &trans         &kp LC(LS(R))  &kp LC(T)  &trans                                                                                       &trans    &kp LC(Y)  &kp PG_UP  &kp PG_UP   &copy_macro   &paste_macro  &trans
&kt LSHIFT     &Lshift_macro  &Lshift_macro  &Lshift_macro  &Lshift_macro  &kp MINUS  &kp LC(TAB)      &kp LC(LEFT_SHIFT)  &trans                 &copy_macro        &paste_macro  &kp HOME  &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT     &kp END       &cut_macro
&Lshift_macro  &kp LC(Z)      &cut_macro     &copy_macro    &paste_macro   &trans                                          &mt LC(HOME) HOME      &mt LC(HOME) HOME                          &kp LC(N)  &kp PG_DN  &kp PG_DN   &paste_macro  &kt LSHIFT    &Rshift_macro
&kp LCTRL      &trans         &trans         &trans         &trans                    &mt LCTRL SPACE  &trans              &mt LC(END) END        &mt LC(END) END    &kp ENTER     &kp BSPC             &trans     &trans      &trans        &trans        &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
